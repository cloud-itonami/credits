(require 'clojure.test)
(load-file "src/credits/methods/engi.cljk")
(load-file "methods/test_engi.cljk")
(load-file "src/credits/engi/codec.cljk")
(load-file "src/credits/engi/crypto.cljk")
(load-file "src/credits/engi/replay.cljk")
(load-file "src/credits/engi/journal.cljk")
(load-file "src/credits/engi/identity.cljk")
(load-file "src/credits/engi/store.cljk")
(load-file "src/credits/engi/relay.cljk")
(load-file "src/credits/engi/checkpoint.cljk")
(load-file "src/credits/engi/standing.cljk")
(load-file "src/credits/engi/commons.cljk")
(load-file "src/credits/engi/netting.cljk")
(load-file "src/credits/engi/migration.cljk")
(load-file "src/credits/engi/audit.cljk")
(load-file "src/credits/engi/benchmark.cljk")
(load-file "src/credits/engi/atproto.cljk")
(load-file "test/credits/engi_r1_test.cljk")
(load-file "test/credits/engi_r2_test.cljk")
(load-file "test/credits/engi_r3_test.cljk")
(load-file "test/credits/engi_r4_test.cljk")
(load-file "test/credits/engi_r5_test.cljk")
(load-file "test/credits/engi_r6_test.cljk")
(when-not (System/getProperty "babashka.version")
  ;; The production transport uses the JDK HttpServer/HttpClient modules,
  ;; and the WebAuthn verifier uses json.compat. JVM tests exercise both.
  (load-file "src/credits/engi/transport.cljk")
  (load-file "src/credits/engi/relay_main.cljk")
  (load-file "src/credits/engi/sync.cljk")
  (load-file "src/credits/engi/webauthn.cljk")
  (load-file "src/credits/engi/at_client.cljk")
  (load-file "test/credits/engi_r7_adapters_test.cljk")
  (load-file "test/credits/engi_webauthn_test.cljk")
  (load-file "test/credits/engi_at_client_test.cljk")
  (load-file "test/credits/engi_sync_test.cljk"))
(let [result (clojure.test/run-tests 'credits.methods.test-engi)]
  (let [r1-result (clojure.test/run-tests 'credits.engi-r1-test)]
    (let [r2-result (clojure.test/run-tests 'credits.engi-r2-test)]
      (let [r3-result (clojure.test/run-tests 'credits.engi-r3-test)]
        (let [r4-result (clojure.test/run-tests 'credits.engi-r4-test)]
          (let [r5-result (clojure.test/run-tests 'credits.engi-r5-test)]
            (let [r6-result (clojure.test/run-tests 'credits.engi-r6-test)]
              (let [adapter-result
                    (if (System/getProperty "babashka.version")
                      {:fail 0 :error 0}
                      (clojure.test/run-tests
                       'credits.engi-r7-adapters-test
                       'credits.engi-webauthn-test
                       'credits.engi-at-client-test
                       'credits.engi-sync-test))]
                (when (pos? (+ (:fail result) (:error result)
                               (:fail r1-result) (:error r1-result)
                               (:fail r2-result) (:error r2-result)
                               (:fail r3-result) (:error r3-result)
                               (:fail r4-result) (:error r4-result)
                               (:fail r5-result) (:error r5-result)
                               (:fail r6-result) (:error r6-result)
                               (:fail adapter-result)
                               (:error adapter-result)))
                  (System/exit 1)))))))))
  )
