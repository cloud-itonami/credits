{:paths ["src" "."]
 ;; ws-valueflo-vocabulary supplies the Valueflows action behaviour table and the
 ;; unit registry, used ONLY by credits.engi.valueflows -- a read-only
 ;; projection. The kernel (credits.methods.engi) does not depend on it and its
 ;; constitutional boundary is untouched: projection is not admission.
 :deps {
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       ;; Retire org.clojure/data.json (JVM maven) for kotoba-lang/json —
        ;; same pattern as kakaku/sukashi/kanae cheshire exit.
        io.github.kotoba-lang/json {:git/sha "1adc364ea7011d1fc8ade6d31a34bbbef76ecefe"}
        io.github.kotoba-lang/ws-valueflo-vocabulary
        {:git/url "https://github.com/kotoba-lang/ws-valueflo-vocabulary.git"
         :git/sha "95e552dcacfb54f89b539f5a394bdfe83c0a0df6"}}
 :aliases
 {:relay {:main-opts ["-m" "credits.engi.relay-main"]}
  ;; dev/ holds the one-off corpus generator; it is not on the library path.
  ;; `clojure -M:dev -m credits.dev.generate-example-journal`
  :dev {:extra-paths ["dev"]}

  :test {:extra-paths ["test" "dev"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main" "--lint" "src" "test" "--fail-level" "error"]}}}
